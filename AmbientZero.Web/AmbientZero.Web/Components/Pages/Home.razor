@page "/"
@inject NavigationManager _nav

@code {
    private async Task NavigateToTemperatureGraph()
    {
        _nav.NavigateTo($"/graph");
    }
}

<PageTitle>Home</PageTitle>

<center><h1>Welcome to Ambient Zero Webapp</h1></center>

<div class="dashboard-logo"><img src="/images/house.png" /></div>

<div class="dashboard-description-container">Welcome to the application to control your temperature sensor, in the Temperature Graph option you will find all the measurements of the sensors during a day, and in the Sensors section you will be able to configure your sensors or see the individual chart for the sensor, please keep in mind that this is an ever evolving project, if you find a bug please report it or if you have questions you can ask it on the forum</div>

<center>
    <a href="/sensors">
        <button type="button" class="btn btn-outline-dark dashboard-buttons">
            <div style ="width: 160px;"><Icon Name="IconName.BarChart" Class="fs-1" Style="cursor: pointer"></Icon></div>
            <div>Sensors</div>
        </button>
    </a>
    <a href="/graph">
        <button type="button" class="btn btn-outline-dark dashboard-buttons">
            <div style="width: 160px;"><Icon Name="IconName.BarChart" Class="fs-1" Style="cursor: pointer"></Icon></div>
            <div>Temperature Graph</div>
        </button>
    </a>
</center>