@page "/settings"
@rendermode InteractiveWebAssembly
@using AmbientZero.Web.Client.Interfaces
@using AmbientZero.Web.Client.Models
@inject IClientSensorService SensorService
@inject PersistentComponentState ApplicationState
@inherits LayoutComponentBase
<Modal @ref="nameModal" Title="Edit Sensor Name">
    <BodyTemplate>
        Device Id: @selectedDeviceId
        <InputText @bind-Value="@deviceVirtualName" />
    </BodyTemplate>
    <FooterTemplate>
        <Button Color="ButtonColor.Primary" @onclick="OnNameModalSaveClick">Save changes</Button>
        <Button Color="ButtonColor.Danger" @onclick="OnNameModalCloseClick">Close</Button>
    </FooterTemplate>
</Modal>

<Modal @ref="lightModal" Title="Edit Sensor Light Settings">
    <BodyTemplate>
        <Switch Label="Enable Lights" Value="selectedSensorSettings.IsLightEnabled" ValueExpression="() => selectedSensorSettings.IsLightEnabled" ValueChanged="EnableLightSwitchChanged" />
        <Switch Label="Disable Lights On Schedule" Disabled="!selectedSensorSettings.IsLightEnabled" Value="selectedSensorSettings.IsScheduled" ValueExpression="() => selectedSensorSettings.IsScheduled" ValueChanged="IsScheduledSwitchChanged" />
        @if (hideScheduleOptions)
        {
            <div class="mb-3">
                Diable Start Time
            </div>
            <div class="mb-3">
                <TimeInput TValue="TimeOnly?" @bind-Value="selectedSensorSettings.DisableStartTime" />
            </div>
            <div class="mb-3">
                Disable End Time
            </div>
            <div class="mb-3">
                <TimeInput TValue="TimeOnly?" @bind-Value="selectedSensorSettings.DisableEndTime" />
            </div>
        }
    </BodyTemplate>
    <FooterTemplate>
        <Button Color="ButtonColor.Primary" @onclick="OnLightModalSaveClick">Save changes</Button>
        <Button Color="ButtonColor.Danger">Close</Button>
    </FooterTemplate>
</Modal>

<PageTitle>Settings</PageTitle>

<h1>Settings</h1>
<AutoComplete @bind-Value="selectedTz"
              TItem="TimeZoneInfo"
              DataProvider="CustomersDataProvider"
              PropertyName="Id"
              Placeholder="Search a customer..."
              StringComparison="StringComparison.InvariantCultureIgnoreCase"
              OnChanged="(TimeZoneInfo customer) => OnAutoCompleteChanged(customer)" />

@code {
    TimeZoneInfo timeZoneInfo;

    private List<SensorInformation> sensors = new();
    private IEnumerable<TimeZoneInfo> tz;
    private string selectedTz;
    private string selectedDeviceId;
    private bool hideScheduleOptions = false;
    private SensorSettings selectedSensorSettings = new();
    private Modal nameModal;
    private Modal lightModal;
    private string deviceVirtualName;

    private async Task OnShowNameModalClick(int i)
    {
        selectedDeviceId = sensors.Where(x => x.Id == i).FirstOrDefault()!.DeviceId;

        await nameModal!.ShowAsync();
    }

    private async Task OnShowLightModalClick(int i)
    {
        selectedSensorSettings = sensors.Where(x => x.Id == i)?.FirstOrDefault()?.SensorSetting ?? new SensorSettings();
        await lightModal!.ShowAsync();
    }

    private void ScheduleSwitchChanged()
    {
        hideScheduleOptions = selectedSensorSettings.IsScheduled;
    }

    private async Task OnNameModalSaveClick()
    {
        await SensorService.UpdateSensorName(selectedDeviceId, deviceVirtualName);
        deviceVirtualName = string.Empty;
        await nameModal!.HideAsync();
    }

    private async Task OnNameModalCloseClick()
    {
        deviceVirtualName = string.Empty;
        await nameModal!.HideAsync();
    }

    private async Task GetSensorInformation()
    {
        sensors = (await SensorService.GetSensorInformation()).ToList();
    }

    private PersistingComponentStateSubscription persistingSubscription;

    protected override async Task OnInitializedAsync()
    {
        tz = SensorService.timezone();
    }

    private void EnableLightSwitchChanged(bool value)
    {
        selectedSensorSettings.IsLightEnabled = value;
        if (!value)
        {
            selectedSensorSettings.IsScheduled = false;
        }
    }

    private void IsScheduledSwitchChanged(bool value)
    {
        selectedSensorSettings.IsScheduled = value;
        hideScheduleOptions = value;
    }

    private async Task OnLightModalSaveClick()
    {
        await SensorService.UpdateSensorSetting(selectedSensorSettings);
        await lightModal!.HideAsync();
    }

    private async Task<AutoCompleteDataProviderResult<TimeZoneInfo>> CustomersDataProvider(AutoCompleteDataProviderRequest<TimeZoneInfo> request)
    {
        return await Task.FromResult(request.ApplyTo(tz));
    }

    private void OnAutoCompleteChanged(TimeZoneInfo customer)
    {
        // TODO: handle your own logic

        // NOTE: do null check
        Console.WriteLine($"'{customer?.Id}' selected.");
    }
}

